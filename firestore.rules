rules_version = '2';

// Collection: users — Firebase Auth UID
//   email, displayName, workName, canDashboard, canPerformance,
//   slackMemberId, role (director|lead|member|superAdmin),
//   divisionId, teamId, createdAt, lastSeenAt
// Collection: orgUnits — 본부(division) / 팀(team)
// Collection: projectPms, csOwners, alertLogs — 슈퍼관리자·본부장
// 이메일 슈퍼관리자 shlim@sevensplit.com 은 고정. 본부장은 role=director.

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isSuperAdmin() {
      return signedIn()
        && request.auth.token.email is string
        && request.auth.token.email.lower() == 'shlim@sevensplit.com';
    }

    function isDirector() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'director';
    }

    function canManageAccess() {
      return isSuperAdmin() || isDirector();
    }

    function actorDivisionId() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('divisionId', '');
    }

    function targetIsBootstrapAdmin() {
      return resource.data.email is string
        && resource.data.email.lower() == 'shlim@sevensplit.com';
    }

    function hasUserKeys(data) {
      return data.keys().hasAll([
        'email',
        'displayName',
        'canDashboard',
        'canPerformance',
        'createdAt',
        'lastSeenAt'
      ]);
    }

    function isValidUser(data) {
      return hasUserKeys(data)
        && data.email is string
        && data.email.size() > 3
        && data.email.matches('.*@sevensplit\\.com')
        && data.displayName is string
        && data.displayName.size() < 120
        && data.canDashboard is bool
        && data.canPerformance is bool
        && data.createdAt is string
        && data.lastSeenAt is string
        && (!('workName' in data)
          || (data.workName is string && data.workName.size() < 80))
        && (!('slackMemberId' in data)
          || (data.slackMemberId is string && data.slackMemberId.size() < 32))
        && (!('role' in data)
          || (data.role is string && data.role in ['lead', 'member', 'director', 'superAdmin']))
        && (!('divisionId' in data)
          || (data.divisionId is string && data.divisionId.size() < 80))
        && (!('teamId' in data)
          || (data.teamId is string && data.teamId.size() < 80));
    }

    function directorKeepsOrSetsHome(data) {
      return actorDivisionId() != ''
        && (
          resource.data.get('divisionId', '') == ''
          || resource.data.get('divisionId', '') == actorDivisionId()
        )
        && data.get('divisionId', '') == actorDivisionId();
    }

    function directorRolePatchOk(data) {
      return resource.data.get('role', 'member') == 'director'
        ? data.role == 'director'
        : data.role in ['lead', 'member'];
    }

    match /users/{uid} {
      allow get: if isSelf(uid) || canManageAccess();
      allow list: if signedIn();
      allow create: if isSelf(uid)
        && isValidUser(request.resource.data)
        && request.resource.data.email.lower() == request.auth.token.email.lower()
        && request.resource.data.canDashboard == true
        && request.resource.data.canPerformance == (
          request.auth.token.email.lower() == 'shlim@sevensplit.com'
        )
        && request.resource.data.get('role', 'member') == 'member'
        && request.resource.data.get('divisionId', '') == ''
        && request.resource.data.get('teamId', '') == '';
      allow update: if isValidUser(request.resource.data)
        && (
          (
            isSelf(uid)
            && request.resource.data.email == resource.data.email
            && request.resource.data.canDashboard == resource.data.canDashboard
            && request.resource.data.canPerformance == resource.data.canPerformance
            && request.resource.data.createdAt == resource.data.createdAt
            && request.resource.data.get('slackMemberId', '') == resource.data.get('slackMemberId', '')
            && request.resource.data.get('role', '') == resource.data.get('role', '')
            && request.resource.data.get('divisionId', '') == resource.data.get('divisionId', '')
            && request.resource.data.get('teamId', '') == resource.data.get('teamId', '')
          )
          || (
            isSuperAdmin()
            && request.resource.data.email == resource.data.email
            && request.resource.data.createdAt == resource.data.createdAt
          )
          || (
            isDirector()
            && !targetIsBootstrapAdmin()
            && directorKeepsOrSetsHome(request.resource.data)
            && directorRolePatchOk(request.resource.data)
            && request.resource.data.email == resource.data.email
            && request.resource.data.createdAt == resource.data.createdAt
          )
        );
      allow delete: if false;
    }

    match /orgUnits/{id} {
      allow read: if signedIn();
      allow create: if isSuperAdmin()
        || (
          isDirector()
          && actorDivisionId() != ''
          && request.resource.data.kind == 'team'
          && request.resource.data.parentId == actorDivisionId()
        );
      allow update: if isSuperAdmin()
        || (
          isDirector()
          && actorDivisionId() != ''
          && request.resource.data.kind == resource.data.kind
          && request.resource.data.parentId == resource.data.parentId
          && (
            (resource.data.kind == 'division' && id == actorDivisionId())
            || (resource.data.kind == 'team' && resource.data.parentId == actorDivisionId())
          )
        );
      allow delete: if isSuperAdmin()
        || (
          isDirector()
          && actorDivisionId() != ''
          && resource.data.kind == 'team'
          && resource.data.parentId == actorDivisionId()
        );
    }

    match /projectPms/{id} {
      allow read, write: if canManageAccess();
    }

    match /csOwners/{id} {
      allow read, write: if canManageAccess();
    }

    match /alertLogs/{id} {
      allow read, write: if canManageAccess();
    }
  }
}
